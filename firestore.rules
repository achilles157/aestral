rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── User birth profiles ───────────────────────────────────────────────
    // Each authenticated user may only read and write their own document.
    // Guest sessions (isMock: true) never reach Firestore — they use
    // SharedPreferences locally, so no guest UID can match a real auth.uid.
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      // ── User history subcollections ─────────────────────────────────────
      // tarot_history, weton_history, bazi_history — each user owns their own.
      match /tarot_history/{historyId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      match /weton_history/{historyId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      match /bazi_history/{historyId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
    }

    // ── Deny everything else by default ──────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
