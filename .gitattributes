# Auto detect text files and perform LF normalization
* text=auto

# Dart/Flutter source files
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf

# TypeScript (backend)
*.ts text eol=lf
*.js text eol=lf

# Shell scripts
*.sh text eol=lf

# Windows batch files must remain CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
*.tar binary
*.gz binary
*.mp4 binary
*.mov binary
